<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Leo.App.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Leo.App.ViewModels"
    xmlns:controls="using:Leo.App.Controls">
    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="16" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Stats" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="Live throughput and data used per network, which apps use which network, and the connections going through LEO right now." />
            </StackPanel>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Private by design"
                     Message="{x:Bind ViewModel.RetentionText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Clear statistics" Click="Clear_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            AutomationProperties.Name="Clear all saved statistics" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" Title="Couldn't do that"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" Closed="ErrorBar_Closed" />

            <!-- Per network -->
            <TextBlock Text="Networks" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Adapters}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AdapterStatsCardViewModel">
                        <Border Style="{StaticResource LeoCardStyle}" Padding="16">
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="24" Width="40" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind DetailText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind RateText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
                                    <controls:Sparkline Height="56" Primary="{x:Bind ReceiveHistory, Mode=OneWay}" Secondary="{x:Bind SendHistory, Mode=OneWay}"
                                                        AutomationProperties.Name="Throughput over the last 5 minutes" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Text="Last 5 minutes · accent line = download, grey line = upload" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
                                    <controls:WrapPanel HorizontalSpacing="24" VerticalSpacing="4">
                                        <TextBlock Text="{x:Bind SessionText, Mode=OneWay}" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind TodayText, Mode=OneWay}" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind MonthText, Mode=OneWay}" IsTextSelectionEnabled="True" />
                                    </controls:WrapPanel>
                                    <controls:Sparkline Height="28" Capacity="720" Primary="{x:Bind LatencyHistory, Mode=OneWay}"
                                                        AutomationProperties.Name="Latency over the last hour" />
                                    <TextBlock Text="{x:Bind LatencyText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Per app -->
            <TextBlock Text="Apps" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.AppsNote, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <Border Style="{StaticResource LeoCardStyle}" Padding="16,12">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="App" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Network" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Now" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Today" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="This month" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <TextBlock Text="No app traffic counted yet." Visibility="{x:Bind ViewModel.HasNoApps, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Apps}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppUsageRowViewModel">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind App, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Network, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind NowText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind TodayText, Mode=OneWay}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind MonthText, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Live connections -->
            <TextBlock Text="Live connections" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Shown live only. LEO never saves connections or destinations to disk and never writes them to its logs." />
            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                <TextBox x:Name="FilterBox" Width="280" PlaceholderText="Filter by app, address, network or rule"
                         AutomationProperties.Name="Filter connections" TextChanged="FilterBox_TextChanged" />
                <Button Content="{x:Bind ViewModel.PauseText, Mode=OneWay}" Click="Pause_Click"
                        AutomationProperties.Name="Pause or resume the live connection list" />
            </controls:WrapPanel>
            <TextBlock Text="{x:Bind ViewModel.ConnectionsNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <Border Style="{StaticResource LeoCardStyle}" Padding="16,12">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="2.4*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="App" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Destination" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Network" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Rule" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="Data" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Connections}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConnectionRowViewModel">
                                <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleText, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="2.4*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind App, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Destination, Mode=OneWay}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Network, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Rule, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind BytesText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
