<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Leo.App.Pages.DestinationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Leo.App.ViewModels"
    xmlns:controls="using:Leo.App.Controls">
    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="URLs &amp; IPs" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="Choose which network a website, address or port uses. Destination rules beat app rules; a rule for one app and one destination beats both. Local network traffic is never affected." />
            </StackPanel>

            <InfoBar IsOpen="True" IsClosable="False" Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                     Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" Message="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <InfoBar IsClosable="False" Severity="Warning" Title="VPN"
                     IsOpen="{x:Bind ViewModel.VpnBanner, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                     Message="{x:Bind ViewModel.VpnBanner, Mode=OneWay}" />
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" Title="Couldn't apply that"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" Closed="ErrorBar_Closed" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Add_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Add destination">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add destination" />
                    </StackPanel>
                </Button>
                <Button Content="{x:Bind ViewModel.MasterButtonText, Mode=OneWay}" Click="Master_Click"
                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.MasterButtonText, Mode=OneWay}" />
            </StackPanel>

            <!-- Test a rule -->
            <Border Style="{StaticResource LeoCardStyle}" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Test a rule" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                        <TextBox x:Name="TestBox" Width="320" PlaceholderText="youtube.com, https://example.com/page or 203.0.113.7:443"
                                 AutomationProperties.Name="Address to test" KeyDown="TestBox_KeyDown" />
                        <ComboBox x:Name="TestAppBox" MinWidth="180" AutomationProperties.Name="App to test with" />
                        <Button Content="Test" Click="Test_Click" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                AutomationProperties.Name="Test address" />
                        <ProgressRing IsActive="{x:Bind ViewModel.TestBusy, Mode=OneWay}" Width="20" Height="20" />
                    </controls:WrapPanel>
                    <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasTestResult, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.TestRuleText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.TestNetworkText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.TestWhyText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Rules" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="No destinations yet. Use “Add destination” to send a website, address range or port through a network of your choice."
                       Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rules}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:DestinationCardViewModel">
                        <Border Style="{StaticResource LeoCardStyle}" Padding="16">
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="24" Width="40" VerticalAlignment="Top" Margin="0,4,0,0" />

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind DetailText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind RouteText, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>

                                <controls:WrapPanel Grid.Row="1" Grid.Column="1" HorizontalSpacing="6" VerticalSpacing="6">
                                    <Button Click="Target_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind TargetText, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE968;" FontSize="14" />
                                            <TextBlock Text="{x:Bind TargetText, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="Down_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind DownText, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind DownText, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <CheckBox Content="Active" MinWidth="0" IsChecked="{x:Bind IsEnabled, Mode=OneWay}"
                                              Click="Enabled_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" />
                                    <Button Click="Edit_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" AutomationProperties.Name="Edit rule">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                            <TextBlock Text="Edit" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="Up_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}" AutomationProperties.Name="Move up"
                                            ToolTipService.ToolTip="Move up (decides between equally specific rules)">
                                        <FontIcon Glyph="&#xE70E;" FontSize="14" />
                                    </Button>
                                    <Button Click="DownMove_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}" AutomationProperties.Name="Move down"
                                            ToolTipService.ToolTip="Move down (decides between equally specific rules)">
                                        <FontIcon Glyph="&#xE70D;" FontSize="14" />
                                    </Button>
                                    <Button Click="Delete_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}" AutomationProperties.Name="Remove rule">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            <TextBlock Text="Remove" />
                                        </StackPanel>
                                    </Button>
                                </controls:WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Per-network DNS -->
            <StackPanel Spacing="4" Margin="0,8,0,0">
                <TextBlock Text="DNS per network" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="While split tunneling runs, each name lookup goes out through the network its traffic will use, to that network's DNS. Websites with a rule are looked up through their network; everything else through your Primary." />
            </StackPanel>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Dns}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:NetworkDnsCardViewModel">
                        <Border Style="{StaticResource LeoCardStyle}" Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ServersText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="Dns_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                        AutomationProperties.Name="Change DNS" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        <TextBlock Text="Change DNS" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
