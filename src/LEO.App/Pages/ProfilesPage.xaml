<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Leo.App.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Leo.App.ViewModels"
    xmlns:controls="using:Leo.App.Controls">
    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Profiles" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="A profile remembers its own network priority, app rules, URL &amp; IP rules, DNS and Wi-Fi pins. The Networks, Apps and URLs &amp; IPs pages always show and change the active profile. Profiles can turn on by themselves when a Wi-Fi network or an adapter shows up." />
            </StackPanel>

            <InfoBar IsOpen="True" IsClosable="False" Severity="{x:Bind ViewModel.ReasonSeverity, Mode=OneWay}"
                     Title="{x:Bind ViewModel.ActiveTitle, Mode=OneWay}" Message="{x:Bind ViewModel.ReasonText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Back to automatic" Click="BackToAuto_Click"
                            Visibility="{x:Bind ViewModel.ShowBackToAutomatic, Mode=OneWay}"
                            AutomationProperties.Name="Back to automatic profile switching" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" Title="Couldn't apply that"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" Closed="ErrorBar_Closed" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="Add_Click" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Add profile">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add profile" />
                    </StackPanel>
                </Button>
                <Button Content="{x:Bind ViewModel.AutoSwitchButtonText, Mode=OneWay}" Click="AutoSwitch_Click"
                        IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.AutoSwitchButtonText, Mode=OneWay}" />
            </StackPanel>

            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="When several profiles' triggers match, the one higher in the list wins. LEO waits 5 seconds before switching to a profile (20 seconds when the active one's trigger goes away), so a short drop doesn't flip profiles. Switching never forgets or adds Wi-Fi networks; it only changes which networks LEO keeps adapters on." />

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Profiles}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileCardViewModel">
                        <Border Style="{StaticResource LeoCardStyle}" Padding="16">
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="24" Width="40" VerticalAlignment="Top" Margin="0,4,0,0" />

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <Border Visibility="{x:Bind IsActive}" CornerRadius="4" Padding="6,1,6,2" VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="Active" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind TriggerText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind SummaryText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind PriorityText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <controls:WrapPanel Grid.Row="1" Grid.Column="1" HorizontalSpacing="6" VerticalSpacing="6">
                                    <Button Click="Activate_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanActivate}"
                                            AutomationProperties.Name="{x:Bind ActivateText}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                                            <TextBlock Text="Switch to" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="Edit_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit}" AutomationProperties.Name="Edit profile">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                            <TextBlock Text="Edit" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="Up_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanMoveUp}" Visibility="{x:Bind IsNotDefault}"
                                            AutomationProperties.Name="Move up" ToolTipService.ToolTip="Move up (wins when several profiles match)">
                                        <FontIcon Glyph="&#xE70E;" FontSize="14" />
                                    </Button>
                                    <Button Click="Down_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanMoveDown}" Visibility="{x:Bind IsNotDefault}"
                                            AutomationProperties.Name="Move down" ToolTipService.ToolTip="Move down">
                                        <FontIcon Glyph="&#xE70D;" FontSize="14" />
                                    </Button>
                                    <Button Click="Delete_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanDelete}" Visibility="{x:Bind IsNotDefault}"
                                            AutomationProperties.Name="Delete profile">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            <TextBlock Text="Delete" />
                                        </StackPanel>
                                    </Button>
                                </controls:WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
