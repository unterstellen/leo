<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Leo.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
            <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Service connection -->
            <Border Style="{StaticResource LeoCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind ViewModel.ConnectionGlyph, Mode=OneWay}" FontSize="28" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="The LEO engine runs as a Windows service and keeps your routing rules active even when this window is closed." />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar IsOpen="{x:Bind Networks.FailoverActive, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Title="Failover active" Message="{x:Bind Networks.FailoverText, Mode=OneWay}" />

            <!-- Primary network -->
            <Border Style="{StaticResource LeoCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind Networks.PrimaryGlyph, Mode=OneWay}" FontSize="28" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Primary network" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Networks.PrimaryTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Networks.PrimaryDetail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Manage networks" Click="ManageNetworks_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Engine details -->
            <Border Style="{StaticResource LeoCardStyle}">
                <Grid RowSpacing="10" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="2" Text="Engine" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <TextBlock Grid.Row="1" Text="State" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.EngineStateText, Mode=OneWay}" />

                    <TextBlock Grid.Row="2" Text="Service version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ServiceVersionText, Mode=OneWay}" />

                    <TextBlock Grid.Row="3" Text="Running as" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.RunningAsText, Mode=OneWay}" />

                    <TextBlock Grid.Row="4" Text="Uptime" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}" />

                    <TextBlock Grid.Row="5" Text="Your access" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.AccessText, Mode=OneWay}" />

                    <TextBlock Grid.Row="6" Text="Connected UIs" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.ClientsText, Mode=OneWay}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
