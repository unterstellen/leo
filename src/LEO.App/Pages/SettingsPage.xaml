<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Leo.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Leo.App.Controls">
    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource LeoCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Start LEO at login" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Opens LEO in the system tray when you sign in. Your network rules keep working either way, because the LEO service always starts with Windows." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="On" OffContent="Off"
                                  IsOn="{x:Bind ViewModel.StartAtLogin, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource LeoCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Automatic failover" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="LEO checks every network for real internet every few seconds. When your top network loses internet, traffic moves to the next healthy one, and comes back after it has been fine for 30 seconds." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="On" OffContent="Off"
                                  IsOn="{x:Bind Networks.AutoFailover, Mode=TwoWay}" IsEnabled="{x:Bind Networks.CanEdit, Mode=OneWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource LeoCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Show notifications" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Failover and switch-back, new network adapters, sign-in pages and Wi-Fi reconnects. Shown while LEO is in the tray." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="On" OffContent="Off"
                                  IsOn="{x:Bind ViewModel.ShowNotifications, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Advanced: internet checks -->
            <Border Style="{StaticResource LeoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Advanced: internet checks" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="How often LEO checks each network, how long a problem must last before failing over, and how long a network must be healthy before LEO switches back. The probe addresses are fetched through each network; the first one that answers decides." />
                    </StackPanel>

                    <InfoBar Severity="Error" IsClosable="False" Title="Not saved"
                             IsOpen="{x:Bind Advanced.ErrorText, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                             Message="{x:Bind Advanced.ErrorText, Mode=OneWay}" />

                    <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="12">
                        <NumberBox Header="Check every (s)" Width="170" Minimum="2" Maximum="300" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind Advanced.IntervalSeconds, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <NumberBox Header="Fail over after (s)" Width="170" Minimum="1" Maximum="300" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind Advanced.FailoverDelaySeconds, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <NumberBox Header="Switch back after (s)" Width="170" Minimum="5" Maximum="3600" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind Advanced.FailbackDelaySeconds, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <NumberBox Header="Slow above (ms)" Width="170" Minimum="100" Maximum="10000" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind Advanced.SlowLatencyMs, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                    </controls:WrapPanel>

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBox Header="Probe address 1" Text="{x:Bind Advanced.Probe1Url, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <TextBox Grid.Column="1" Header="Expected answer" PlaceholderText="204 or exact text"
                                 Text="{x:Bind Advanced.Probe1Expect, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <TextBox Grid.Row="1" Header="Probe address 2 (fallback)" Text="{x:Bind Advanced.Probe2Url, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Header="Expected answer" PlaceholderText="204 or exact text"
                                 Text="{x:Bind Advanced.Probe2Expect, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveAdvanced_Click"
                                IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <Button Content="Reset to defaults" Click="ResetAdvanced_Click" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Advanced.StatusText, Mode=OneWay}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource LeoCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock>
                        <Run Text="LEO" /> <Run Text="{x:Bind ViewModel.AppVersion}" />
                    </TextBlock>
                    <TextBlock Text="{x:Bind ViewModel.PublisherLine}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="Free and open source, forever. Licensed under the GNU General Public License v3.0 or later. LEO comes with ABSOLUTELY NO WARRANTY." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton Content="unterstellen.org" NavigateUri="https://unterstellen.org" Padding="0" />
                        <HyperlinkButton Content="inferstellen.com" NavigateUri="https://inferstellen.com" Padding="0" />
                        <HyperlinkButton Content="Source &amp; releases on GitHub" NavigateUri="https://github.com/unterstellen/leo-windows" Padding="0" />
                        <HyperlinkButton Content="License (GPL-3.0)" NavigateUri="https://www.gnu.org/licenses/gpl-3.0.html" Padding="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
