<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Leo.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Leo.App.Controls">
    <!-- Toggles have no On/Off text. Windows' ToggleSwitch template keeps a fixed 12px gap after the switch for that text;
         Margin="0,0,-12,0" cancels it so each switch lines up with its card's right padding. -->
    <ScrollViewer Padding="32,24,32,24">
        <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Style="{StaticResource LeoCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Start LEO at login" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Opens LEO in the system tray when you sign in. Your network rules keep working either way, because the LEO service always starts with Windows." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0"
                                  IsOn="{x:Bind ViewModel.StartAtLogin, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource LeoCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Automatic failover" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="LEO checks every network for real internet every few seconds. When your top network loses internet, traffic moves to the next healthy one, and comes back after it has been fine for 30 seconds." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0"
                                  IsOn="{x:Bind Networks.AutoFailover, Mode=TwoWay}" IsEnabled="{x:Bind Networks.CanEdit, Mode=OneWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource LeoCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Show notifications" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Failover and switch-back, new network adapters, sign-in pages and Wi-Fi reconnects. Shown while LEO is in the tray." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0"
                                  IsOn="{x:Bind ViewModel.ShowNotifications, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Advanced: internet checks -->
            <Border Style="{StaticResource LeoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Advanced: internet checks" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="How often LEO checks each network, how long a problem must last before failing over, and how long a network must be healthy before LEO switches back. The probe addresses are fetched through each network; the first one that answers decides." />
                    </StackPanel>

                    <InfoBar Severity="Error" IsClosable="False" Title="Not saved"
                             IsOpen="{x:Bind Advanced.ErrorText, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                             Message="{x:Bind Advanced.ErrorText, Mode=OneWay}" />

                    <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="12">
                        <NumberBox Header="Check every (s)" Width="170" Minimum="2" Maximum="300" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind Advanced.IntervalSeconds, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <NumberBox Header="Fail over after (s)" Width="170" Minimum="1" Maximum="300" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind Advanced.FailoverDelaySeconds, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <NumberBox Header="Switch back after (s)" Width="170" Minimum="5" Maximum="3600" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind Advanced.FailbackDelaySeconds, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <NumberBox Header="Slow above (ms)" Width="170" Minimum="100" Maximum="10000" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind Advanced.SlowLatencyMs, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                    </controls:WrapPanel>

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBox Header="Probe address 1" Text="{x:Bind Advanced.Probe1Url, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <TextBox Grid.Column="1" Header="Expected answer" PlaceholderText="204 or exact text"
                                 Text="{x:Bind Advanced.Probe1Expect, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <TextBox Grid.Row="1" Header="Probe address 2 (fallback)" Text="{x:Bind Advanced.Probe2Url, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Header="Expected answer" PlaceholderText="204 or exact text"
                                 Text="{x:Bind Advanced.Probe2Expect, Mode=TwoWay}" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveAdvanced_Click"
                                IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <Button Content="Reset to defaults" Click="ResetAdvanced_Click" IsEnabled="{x:Bind Advanced.CanEdit, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Advanced.StatusText, Mode=OneWay}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Updates (M8, LEO.md §24.4): main info on top, switches, then buttons last. -->
            <Border Style="{StaticResource LeoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Updates" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Updates.StateText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Updates.SignedText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Updates.LastCheckText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Check for updates automatically" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Once a day LEO asks GitHub, where LEO is published, whether there's a new version. Nothing about this PC is sent." />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoCheckSwitch" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0"
                                      IsOn="{x:Bind Updates.AutoCheck, Mode=OneWay}" IsEnabled="{x:Bind Updates.CanEdit, Mode=OneWay}" Toggled="UpdateSetting_Toggled" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Install updates automatically" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="LEO checks that an update is signed by LEO's publisher, then installs it. Split tunneling pauses for a few seconds while it does. When this is off, you get a notification instead and update from here." />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoInstallSwitch" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0"
                                      IsOn="{x:Bind Updates.AutoInstall, Mode=OneWay}" IsEnabled="{x:Bind Updates.CanEdit, Mode=OneWay}" Toggled="UpdateSetting_Toggled" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Get canary builds" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                       Text="Test versions published before a release, for trying new things on your own PCs. They may have more bugs." />
                        </StackPanel>
                        <ToggleSwitch x:Name="CanarySwitch" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0"
                                      IsOn="{x:Bind Updates.Canary, Mode=OneWay}" IsEnabled="{x:Bind Updates.CanEdit, Mode=OneWay}" Toggled="UpdateSetting_Toggled" />
                    </Grid>

                    <InfoBar Severity="Error" IsClosable="False" Title="Not done"
                             IsOpen="{x:Bind Updates.ErrorText, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                             Message="{x:Bind Updates.ErrorText, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Updates.AdminHint, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind Updates.HasAdminHint, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Check now" Click="CheckNow_Click" IsEnabled="{x:Bind Updates.CanCheck, Mode=OneWay}" />
                        <Button Content="Update now" Style="{StaticResource AccentButtonStyle}" Click="UpdateNow_Click"
                                Visibility="{x:Bind Updates.ShowUpdateNow, Mode=OneWay}" IsEnabled="{x:Bind Updates.CanUpdateNow, Mode=OneWay}" />
                        <Button Content="Release notes" Click="ReleaseNotes_Click"
                                Visibility="{x:Bind Updates.HasNotes, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About (LEO.md §24.7, §24.8): version and Preview label, signer, licence and links, diagnostics. -->
            <Border Style="{StaticResource LeoCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Updates.VersionText}" />
                        <TextBlock Text="{x:Bind Updates.SignedText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.PublisherLine}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Free and open source, forever. Licensed under the GNU General Public License v3.0 or later. LEO comes with ABSOLUTELY NO WARRANTY. LEO is in Preview until version 1.0." />
                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="4">
                            <HyperlinkButton Content="unterstellen.org" NavigateUri="https://unterstellen.org" Padding="0" />
                            <HyperlinkButton Content="inferstellen.com" NavigateUri="https://inferstellen.com" Padding="0" />
                            <HyperlinkButton Content="Source code of this version" Click="OpenSource_Click" Padding="0" />
                            <HyperlinkButton Content="Third-party notices" Click="OpenNotices_Click" Padding="0" />
                            <HyperlinkButton Content="Privacy" Click="OpenPrivacy_Click" Padding="0" />
                            <HyperlinkButton Content="License (GPL-3.0)" NavigateUri="https://www.gnu.org/licenses/gpl-3.0.html" Padding="0" />
                        </controls:WrapPanel>
                    </StackPanel>

                    <CheckBox x:Name="IncludePersonalCheck" Content="Include network names and addresses in diagnostics" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click" />
                        <Button Content="Uninstall LEO" Click="Uninstall_Click" />
                        <TextBlock x:Name="DiagnosticsStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
