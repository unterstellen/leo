<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Leo.App</RootNamespace>
    <AssemblyName>LEO</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\leo.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, self-contained Windows App SDK: shipped by our own MSI (LEO.md §9). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!--
      Needed for `dotnet publish` of an unpackaged WinUI app: without it the publish output lacks LEO.pri and the
      compiled XAML (*.xbf), so the installed app crashed right after creating its tray icon (found in the first MSI
      test, 2026-11-24). Doesn't make LEO an MSIX package (WindowsPackageType stays None).
    -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      Same as LEO.Service: StreamJsonRpc -> Microsoft.VisualStudio.Threading.Only declares a WPF framework reference.
      LEO's UI is WinUI 3 and never uses WPF; dropping it keeps the WPF/WinForms runtime out of the self-contained
      payload and avoids a WindowsBase.dll clash with the service in the shared install folder (LEO.md §24.1).
    -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <!-- Custom Main for single-instance redirection. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated by tools/make-icon.ps1 from assets/leo.svg -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LEO.Core\LEO.Core.csproj" />
    <ProjectReference Include="..\LEO.Ipc\LEO.Ipc.csproj" />
  </ItemGroup>
</Project>
